# ───────────────────────────────────────────────────────────────
# SENSITIVE OUTPUT — never commit real scan data / evidence / targets
# ───────────────────────────────────────────────────────────────
# Scan & pipeline results
scan_*.json
pipeline_*.json
report_*.json
*_results.json

# Evidence (chain-of-custody artifacts: transcripts, proofs, metadata)
evidence/
**/evidence/

# Generated reports (PDF / CSV / charts)
reports/
*.pdf
# ...except the presentation deck, which is meant to be published
!security_audit_toolkit.pdf
# Report files by name — block even when generated outside reports/
dashboard_*.html
report_*.xlsx
report_*_findings.csv
report_*_ip.csv

# Target / host lists (real infrastructure — keep private)
*hosts*.txt
*hosts*.csv
*_hosts_*.json
dns.txt
websites.csv
report_results.csv
targets.txt
targets.csv

# Local config with API keys (c99, SecurityTrails, etc.)
.env
*.env
config.local.*
secrets.*

